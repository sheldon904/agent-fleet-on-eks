# Copy to deploy/values.production.yaml and fill in from Terraform outputs:
#   terraform -chdir=terraform/envs/dev output irsa_role_arns
# These are IAM role ARNs (not secrets), so the resulting file is safe to commit if you like.
# CD passes image.registry and per-service tags via --set; this file supplies the IRSA ARNs.

secretsStore:
  enabled: true

services:
  governance-mcp:
    serviceAccount:
      irsaRoleArn: "arn:aws:iam::ACCOUNT_ID:role/agent-fleet-governance-mcp-irsa"
  scheduler:
    serviceAccount:
      irsaRoleArn: ""
  ticket-to-pr-runner:
    serviceAccount:
      irsaRoleArn: "arn:aws:iam::ACCOUNT_ID:role/agent-fleet-ticket-to-pr-runner-irsa"
    env:
      DRY_RUN: "false" # real GitHub PRs; also mount a GITHUB_TOKEN secret
  notify-bridge:
    serviceAccount:
      irsaRoleArn: "arn:aws:iam::ACCOUNT_ID:role/agent-fleet-notify-bridge-irsa"
